  lines:
  - id: perdida_mara
    speaker: Nami
    duration: 0
    translations:
    - languageCode: es
      text: "\xBFMam\xE1? \xBFD\xF3nde est\xE1s?"
  - id: escucha
    speaker: Nami
    duration: 0
    translations:
    - languageCode: es
      text: "Puedo sentir a mi mam\xE1 en alg\xFAn lado\u2026"
  - id: nami_atisbo
    speaker: Nami
    duration: 0
    translations:
    - languageCode: es
      text: "\xA1La veo! Tengo que ir con ella."
  - id: nami_senal
    speaker: Nami
    duration: 0
    translations:
    - languageCode: es
      text: "\xBFEh? \xBFQu\xE9 es eso? Tengo que investigar."
  - id: nami_senal
    speaker: Nami
    duration: 0
    translations:
    - languageCode: es
      text: "\xBFEh? \xBFQu\xE9 es eso? Tengo que investigar."
  - id: Mara_inicio
    speaker: Nami
    duration: 15
    translations:
    - languageCode: es
      text: Nami...Hija...Despierta, es hora de irnos...una tormenta se acerca
