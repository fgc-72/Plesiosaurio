%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4a2d507554655f469f71b4a3763bea0, type: 3}
  m_Name: DB_Dialogos
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDatabase
  lines:
  - id: perdida_mara
    speaker: Nami
    duration: 3.5
    translations:
    - languageCode: es
      text: "\xBFMam\xE1? \xBFD\xF3nde est\xE1s?"
    - languageCode: en
      text: Mom? Where are you?
  - id: escucha
    speaker: Nami
    duration: 3.5
    translations:
    - languageCode: es
      text: "Puedo sentir a mi mam\xE1 en alg\xFAn lado\u2026"
    - languageCode: en
      text: I can feel my mom somewhere around here...
  - id: nami_atisbo
    speaker: Nami
    duration: 3.5
    translations:
    - languageCode: es
      text: "\xA1La veo! Tengo que ir con ella."
    - languageCode: en
      text: I see her! I have to go to her.
  - id: nami_senal
    speaker: Nami
    duration: 3.5
    translations:
    - languageCode: es
      text: "\xBFEh? \xBFQu\xE9 es eso? Tengo que investigar."
    - languageCode: en
      text: Huh? What is that? I need to investigate.
  - id: Mara_inicio
    speaker: Mara
    duration: 3.5
    translations:
    - languageCode: es
      text: Nami... Hija, despierta. Tenemos que irnos. Se acerca una tormenta.
    - languageCode: en
      text: Nami... sweetheart, wake up. We have to go. A storm is coming.
  - id: Mara_mitad
    speaker: Mara
    duration: 3.5
    translations:
    - languageCode: es
      text: "\xA1La tormenta ya est\xE1 aqu\xED! Tenemos que darnos prisa. Estas
        ruinas podr\xEDan venirse abajo en cualquier momento."
    - languageCode: en
      text: The storm is here! We have to move, now. These ruins could come crashing
        down on us at any moment.
  - id: cuidado
    speaker: Mara
    duration: 3.5
    translations:
    - languageCode: es
      text: "\xA1Cuidado! Las rocas te har\xE1n ir m\xE1s lento. \xA1Pulsa Y para
        romperlas!"
    - languageCode: en
      text: Watch out! The rocks will slow you down. Press Y to break them!
  - id: donde
    speaker: nami
    duration: 3.5
    translations:
    - languageCode: es
      text: "\xBFD\xF3nde estoy...? Mam\xE1... \xBFMAM\xC1? \xA1\xBFD\xF3nde est\xE1s?!"
    - languageCode: en
      text: Where am I...? Mom... MOM?! Where are you?!
  - id: advertencia
    speaker: mara
    duration: 3.5
    translations:
    - languageCode: es
      text: "\xA1HIJA, CUIDADO! \xA1MIRA ARRIBA!"
    - languageCode: en
      text: NAMI, WATCH OUT!
  - id: nami_limite
    speaker: mara
    duration: 3.5
    translations:
    - languageCode: es
      text: "Nami, no te alejes demasiado. Podr\xEDas perderte."
    - languageCode: en
      text: Nami, don't wander too far. You might get lost.
  - id: nami_tiburon
    speaker: mara
    duration: 3.5
    translations:
    - languageCode: es
      text: "\xBF\xA1Eso es un tibur\xF3n!? \xA1Tengo que escapar!"
    - languageCode: en
      text: Is that a shark coming!? I have to get away!
