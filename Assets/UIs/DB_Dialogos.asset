  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4a2d507554655f469f71b4a3763bea0, type: 3}
  m_Name: DB_Dialogos
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDatabase
  lines:
  - id: perdida_mara
    speaker: Nami
    duration: 3.5
    translations:
    - languageCode: es
      text: "\xBFMam\xE1? \xBFD\xF3nde est\xE1s?"
    - languageCode: en
      text: Mom? Where are you?
  - id: escucha
    speaker: Nami
    duration: 3.5
    translations:
    - languageCode: es
      text: "Puedo sentir a mi mam\xE1 en alg\xFAn lado\u2026"
    - languageCode: en
      text: I can feel my mom somewhere around here...
  - id: nami_atisbo
    speaker: Nami
    duration: 3.5
    translations:
    - languageCode: es
      text: "\xA1La veo! Tengo que ir con ella."
    - languageCode: en
      text: I see her! I have to go to her.
  - id: nami_senal
    speaker: Nami
    duration: 3.5
    translations:
    - languageCode: es
      text: "\xBFEh? \xBFQu\xE9 es eso? Tengo que investigar."
    - languageCode: en
      text: Huh? What is that? I need to investigate.
  - id: Mara_inicio
    speaker: Mara
    duration: 3.5
    translations:
    - languageCode: es
      text: Nami...hija...despierta,tenemos que irnos, una tormenta se acerca
    - languageCode: en
      text: Huh? What is that? I need to investigate.
  - id: Mara_mitad
    speaker: Mara
    duration: 3.5
    translations:
    - languageCode: es
      text: La tormenta esta comenzando, tenemos que apurarnos, todavia hay muchas
        ruinas por aca que nos pueden caer encima
    - languageCode: en
      text: Huh? What is that? I need to investigate.
  - id: cuidado
    speaker: Mara
    duration: 3.5
    translations:
    - languageCode: es
      text: cuidado, las rocas te reelentizan, romplelas con el boton Y
    - languageCode: en
      text: Huh? What is that? I need to investigate.
  - id: donde
    speaker: nami
    duration: 3.5
    translations:
    - languageCode: es
      text: "donde estoy..Mam\xE1? MAM\xC1...donde estas? "
    - languageCode: en
      text: Huh? What is that? I need to investigate.
  - id: advertencia
    speaker: mara
    duration: 3.5
    translations:
    - languageCode: es
      text: 'NAMI, CUIDADO ARRIBA '
    - languageCode: en
      text: Huh? What is that? I need to investigate.
  - id: nami_limite
    speaker: mara
    duration: 3.5
    translations:
    - languageCode: es
      text: 'nami, no te vayas lejos puedes perderte '
    - languageCode: en
      text: Huh? What is that? I need to investigate.
  - id: sonido_tiburon
    speaker: nami
    duration: 3.5
    translations:
    - languageCode: es
      text: 'escucho algo, deberia activar el modo escucha '
    - languageCode: en
      text: Huh? What is that? I need to investigate.
  - id: advertencia_tiburon
    speaker: nami
    duration: 3.5
    translations:
    - languageCode: es
      text: el dibalo, viene un tiburon, deberia escapar
    - languageCode: en
      text: Huh? What is that? I need to investigate.
